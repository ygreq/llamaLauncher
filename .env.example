# ==============================================================================
# LlamaLaunch Container Environment Settings
# ==============================================================================

# User ID and Group ID to run the container (prevents permission issues on host)
PUID=1000
PGID=1000
TZ=UTC

# Port configuration
LLAMALAUNCH_PORT=3000

# Volume Paths
# Default relative paths work out-of-the-box locally.
COMPOSE_DIR=./compose
LLM_MODELS_DIR=./models
OBSIDIAN_DIR=./obsidian

# ------------------------------------------------------------------------------
# Example Volume Paths for NAS / OpenMediaVault:
# ------------------------------------------------------------------------------
# LLM_MODELS_DIR=/shared/AI/GGUF
# OBSIDIAN_DIR=/shared/obsidian
